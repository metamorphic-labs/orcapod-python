+class _O34Narrowed:
+    """PROTOTYPE (ITL-1472, O34): a channel whose rows hold the pod's columns only."""
+
+    def __init__(self, channel: Any, pod: Any) -> None:
+        self._channel, self._pod, self._drop = channel, pod, None
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._channel, name)
+
+    def __aiter__(self) -> Any:
+        return self._rows()
+
+    async def _rows(self) -> Any:
+        async for tag, data in self._channel:
+            if self._drop is None:
+                parameters = self._pod.input_data_schema if self._pod else None
+                data_tags = getattr(self._pod, "fall_through_tags", ())
+                self._drop = (
+                    []
+                    if parameters is None
+                    else [
+                        k
+                        for k in data.keys()
+                        if k not in parameters and k not in data_tags
+                    ]
+                )
+                if len(self._drop) == len(data.keys()):
+                    self._drop = []
+            yield (tag, data.drop(*self._drop) if self._drop else data)
+
+
