+import contextvars  # noqa: E402  # PROTOTYPE
+
+# PROTOTYPE (ITL-1472, O34): the one label appended to a function node's identity
+# tuple when its pod drops data columns its function does not take.
+_O34_LABEL = "drops_extra_columns"
+
+
+def drops_extra_columns_suffix(pod: Any) -> tuple[str, ...]:
+    """``(label,)`` when ``pod`` drops extra columns, else ``()``."""
+    plain = getattr(pod, "_plain_pod", pod)
+    return (_O34_LABEL,) if getattr(plain, "_o34_mark", None) is _O34_LABEL else ()
+
+
+_O34_LENIENT: contextvars.ContextVar[bool] = contextvars.ContextVar(
+    "o34_lenient", default=False
+)
+
+
+def _o34_marked(pod: Any, mode: str, ignored: Any = None) -> Any:
+    """PROTOTYPE (ITL-1472, O34, variant B): ``pod`` with its input mode in its identity.
+
+    ``O34_MARK`` names the mode that is marked (``lenient`` or ``strict``); the other
+    mode, and every pod when it is unset (variant A), keeps today's identity.
+    """
+    import copy
+    import os
+
+    chosen = os.environ.get("O34_MARK")
+    if not isinstance(pod, FunctionPod):
+        return pod
+    if chosen in ("ignored", "bool", "label"):
+        # Marked only where the default mode ignores columns: with the names
+        # ("ignored"), a boolean field ("bool") or, the developer's encoding, one
+        # label appended to the node's identity tuple ("label").
+        if mode != "lenient" or not ignored:
+            return pod
+        mark: Any = (
+            ignored if chosen == "ignored" else True if chosen == "bool" else _O34_LABEL
+        )
+    elif chosen == mode:
+        mark = mode
+    else:
+        return pod
+    marked = copy.copy(pod)
+    marked._content_hash_cache = {}
+    marked._pipeline_hash_cache = {}
+    marked._o34_mark = mark
+    return marked
+
+
