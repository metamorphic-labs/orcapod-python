+class _NoTracker:
+    """PROTOTYPE (ITL-1472, O34): records nothing."""
+
+    def record_operator_pod_invocation(self, *args: Any, **kwargs: Any) -> None:
+        return None
+
+
+class ParameterColumns(SelectDataColumns):
+    """PROTOTYPE (ITL-1472, O34): the columns a function pod reads of its input.
+
+    Not a step: it is recorded nowhere, and the stream it gives has the identity of
+    its input (``DynamicPodStream`` asks ``TRANSPARENT``).
+    """
+
+    TRANSPARENT: ClassVar[bool] = True
+
+    def __init__(self, columns: str | Collection[str]):
+        super().__init__(columns, strict=True, tracker_manager=_NoTracker())
+
+
+def parameter_columns(pod: Any, stream: Any) -> Any:
+    """PROTOTYPE: ``stream`` as ``pod`` reads it: parameters and fall-through tags."""
+    _, data_schema = stream.output_schema()
+    parameters = pod.input_data_schema
+    data_tags = getattr(pod, "fall_through_tags", ())
+    kept = [n for n in data_schema if n in parameters or n in data_tags]
+    if not kept or len(kept) == len(data_schema):
+        return stream
+    return ParameterColumns(kept).process(stream)
+
+
