+class FunctionInputSelect(SelectDataColumns):
+    """PROTOTYPE (ITL-1472, O34): the column selection a function pod adds for itself.
+
+    Its identity includes the pod it serves, so two pods taking the same columns of
+    one stream have two selector nodes.
+    """
+
+    def __init__(self, columns: str | Collection[str], pod: Any, **kwargs):
+        self.pod = pod
+        super().__init__(columns, strict=True, **kwargs)
+
+    def identity_structure(self) -> Any:
+        return (self.__class__.__name__, list(self.columns), self.pod)
+
