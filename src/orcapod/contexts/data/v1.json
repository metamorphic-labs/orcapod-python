{
    "context_key": "std:v1:default",
    "version": "v1",
    "description": "Data context std:v1, the hashing generation H1, first released in Orcapod 0.4.0. Frozen when 0.4.0 is released, except its golden history, which only grows; editable in place until then.",
    "released_in": null,
    "previous": "std:v0.1:default",
    "file_hasher": {
        "_class": "orcapod.hashing.file_hashers.FileHasher",
        "_config": {}
    },
    "directory_hasher": {
        "_class": "orcapod.hashing.directory_hashers.BasicDirectoryHasher",
        "_config": {
            "file_hasher": {
                "_ref": "file_hasher"
            }
        }
    },
    "type_converter": {
        "_class": "orcapod.semantic_types.universal_converter.UniversalTypeConverter",
        "_config": {
            "logical_type_registry": {
                "_ref": "logical_type_registry"
            }
        }
    },
    "function_semantic_hasher": {
        "_class": "orcapod.hashing.semantic_hashing.function_info_extractors.FunctionSignatureExtractor",
        "_config": {
            "include_module": true,
            "include_defaults": true,
            "type_converter": {
                "_ref": "type_converter"
            }
        }
    },
